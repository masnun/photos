# Cloudflare R2 credentials for the local admin server.
# Copy to .env (gitignored) and fill in. Loaded into the shell before `make run`.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public origin for the bucket. Either a custom domain bound to the bucket
# (recommended, e.g. https://photos.masnun.com) or the Cloudflare-issued
# r2.dev URL (e.g. https://pub-xxxx.r2.dev).
R2_PUBLIC_URL=

# Anthropic API key for `admin classify` (Claude vision genre classifier).
# Not needed for serve / ingest.
ANTHROPIC_API_KEY=
